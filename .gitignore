/reference/
.snakemake/
# Study folders stay untracked (data, artefacts, comparison-* outputs), except
# each study's additional_comparison_scripts/, which is code only.
/main/*
!/main/*/
/main/*/*
!/main/*/additional_comparison_scripts/
/main/*/additional_comparison_scripts/Rplots.pdf
/config/*
!/config/config_TEMPLATE.yaml

