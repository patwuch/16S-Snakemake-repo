Bootstrap: docker
From: condaforge/miniforge3:latest

%files
    envs/metacoder-env.yaml /opt/envs/metacoder-env.yaml

%post
    conda env create -f /opt/envs/metacoder-env.yaml -p /opt/conda-env
    conda clean -afy
    # metacoder is on CRAN only; pinned to 0.3.9, dependencies from the conda env.
    # It compiles (Rcpp), so the env's make and compilers must be on PATH here.
    # Current release first; the Archive path once a newer version supersedes it.
    export PATH=/opt/conda-env/bin:$PATH
    /opt/conda-env/bin/Rscript -e 'for (u in c("https://cran.r-project.org/src/contrib/metacoder_0.3.9.tar.gz", "https://cran.r-project.org/src/contrib/Archive/metacoder/metacoder_0.3.9.tar.gz")) if (!requireNamespace("metacoder", quietly = TRUE)) try(install.packages(u, repos = NULL, type = "source"))'
    /opt/conda-env/bin/Rscript -e 'stopifnot(packageVersion("metacoder") == "0.3.9"); library(svglite)'

%environment
    export PATH=/opt/conda-env/bin:$PATH

%runscript
    exec "$@"

%labels
    Source envs/metacoder-env.yaml
